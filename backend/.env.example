# Default: mock mode. Keep this true until you have a real model provider configured.
JI_ENVIRONMENT=development
JI_AUTH_REQUIRED=true
# For local parser debugging only, set JI_AUTH_REQUIRED=false. Production always requires auth.
JI_RATE_LIMIT_ENABLED=true
# Rate limiting can be disabled only when JI_ENVIRONMENT=development.
JI_CORS_ALLOWED_ORIGINS=https://primarytask.top
JI_MAX_UPLOAD_BYTES=10485760
JI_MAX_IMAGE_PIXELS=20000000
JI_IMAGE_VALIDATION_TIMEOUT_SECONDS=10
JI_IMAGE_PROCESS_TIMEOUT_SECONDS=90

JI_AI_MOCK=true

# Example for an OpenAI-compatible multimodal endpoint.
# Put real secrets in .env or environment variables only. Do not put them in Android App code.
JI_AI_MODEL_API_KEY=
JI_AI_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JI_AI_MODEL_NAME=qwen-vl-plus
JI_AI_MODEL_TIMEOUT=60

# Some providers may not support response_format. Set false if the provider rejects it.
JI_AI_RESPONSE_FORMAT_JSON=true
